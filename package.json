{
  "name": "daykind-demo",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:serve": "supabase functions serve checkout",
    "local:env": "node scripts/local-env.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "1.170.42",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.3",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.16",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "1.168.43",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.12.0",
    "msw": "^2.15.0",
    "prettier": "^3.8.1",
    "shadcn": "^4.21.4",
    "supabase": "^2.120.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.18.0"
  }
}
